export enum ErrorCode {
  CANCELLED = 'CANCELLED',
  TIMEOUT = 'TIMEOUT',
  POLICY_DENIED = 'POLICY_DENIED',
  RESPONSE_TOO_LARGE = 'RESPONSE_TOO_LARGE',
  NETWORK_ERROR = 'NETWORK_ERROR',
  TLS_HANDSHAKE = 'TLS_HANDSHAKE',
  BROWSER_DOWNLOAD_FAILED = 'BROWSER_DOWNLOAD_FAILED',
  BROWSER_RETRY_ON_DISPLAY = 'BROWSER_RETRY_ON_DISPLAY',
  BROWSER_IMAGE_UNREADABLE = 'BROWSER_IMAGE_UNREADABLE',
  BROWSER_MESSAGE_FAILED = 'BROWSER_MESSAGE_FAILED',
  PARSE_ERROR = 'PARSE_ERROR',
  IO_ERROR = 'IO_ERROR',
  CORRUPT_FILE = 'CORRUPT_FILE',
  DATABASE_VERSION = 'DATABASE_VERSION',
  CONFIG_INVALID = 'CONFIG_INVALID',
  CONFLICT = 'CONFLICT',
  UNSUPPORTED = 'UNSUPPORTED',
  RULE_INVALID = 'RULE_INVALID',
  ACCESS_DENIED = 'ACCESS_DENIED',
  AUTH_REQUIRED = 'AUTH_REQUIRED',
  NOT_FOUND = 'NOT_FOUND',
  RATE_LIMITED = 'RATE_LIMITED',
  SOURCE_QUOTA = 'SOURCE_QUOTA',
  HTTP_SERVER = 'HTTP_SERVER',
  EMPTY_UNEXPECTED = 'EMPTY_UNEXPECTED',
  CONTENT_CHANGED = 'CONTENT_CHANGED',
  ENGINE_INCOMPATIBLE = 'ENGINE_INCOMPATIBLE',
  DISABLED = 'DISABLED',
  OFFLINE = 'OFFLINE',
  STORAGE_FULL = 'STORAGE_FULL',
  IMAGE_EXPIRED = 'IMAGE_EXPIRED'
  ,WAITING_WIFI = 'WAITING_WIFI'
}

export class AppError extends Error {
  readonly code: ErrorCode;

  constructor(code: ErrorCode, safeMessage: string) {
    super(safeMessage);
    this.name = 'AppError';
    this.code = code;
  }
}
